[Unit]
Description=Process Thanda quote notification outbox
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/thanda-store/thanda-store
EnvironmentFile=/etc/thanda-store-supplier.env
EnvironmentFile=/etc/thanda-store-notifications.env
ExecStart=/usr/bin/node scripts/process-quote-notifications.mjs
TimeoutStartSec=65
