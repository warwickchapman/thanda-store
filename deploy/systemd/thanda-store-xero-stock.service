[Unit]
Description=Sync Thanda Store planning stock and accepted quote reservations from Xero
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/thanda-store/thanda-store
EnvironmentFile=/etc/thanda-store-xero.env
ExecStart=/usr/bin/npm run sync:xero-planning
