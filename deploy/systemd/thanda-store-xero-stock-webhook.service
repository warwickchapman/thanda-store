[Unit]
Description=Refresh Thanda Store local stock after Xero invoice changes
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/thanda-store/thanda-store
EnvironmentFile=/etc/thanda-store-xero.env
ExecStart=/usr/bin/npm run sync:xero-stock -- --if-requested
